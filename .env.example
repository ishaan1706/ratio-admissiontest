# Ratio — Production Environment Variables
# Copy to .env on Render, Railway, or Fly.io when going live with real payments.

PORT=3000
NODE_ENV=production
APP_URL=https://ratioprep.com
DATA_DIR=/data
SESSION_SECRET=replace-with-a-long-random-hex-string

# Stripe Billing (requires an 18+ account holder / parent or guardian)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_SEASON=price_...

# Optional comma-separated Pro access codes (for Lemon Squeezy / Gumroad / beta testers)
RATIO_ACCESS_CODES=RATIO-FOUNDER,RATIO-PRO-2026

# Optional static-host Payment Link fallbacks (used if backend Stripe is not configured)
VITE_CHECKOUT_URL_MONTHLY=
VITE_CHECKOUT_URL_SEASON=
